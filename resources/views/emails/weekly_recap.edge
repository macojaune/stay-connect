<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="x-apple-disable-message-reformatting" />
    <title>Les sorties de la semaine · {{ brandName }}</title>
    <style>
      a:focus-visible { outline: 3px solid #17131b; outline-offset: 3px; }
      @media only screen and (max-width: 660px) {
        .shell { width: 100% !important; }
        .outer { padding: 0 !important; }
        .masthead { padding: 23px 20px !important; }
        .masthead-name { font-size: 27px !important; }
        .masthead-note { font-size: 10px !important; }
        .edition { padding: 13px 20px !important; font-size: 12px !important; }
        .intro { padding: 24px 20px !important; }
        .content { padding: 0 14px 30px !important; }
        .lead-art, .lead-copy { display: block !important; width: 100% !important; box-sizing: border-box !important; }
        .lead-cover { width: 100% !important; max-width: 100% !important; height: auto !important; }
        .lead-copy { padding: 22px !important; }
        .lead-artist { font-size: 32px !important; line-height: 35px !important; }
        .lead-title { font-size: 25px !important; line-height: 30px !important; }
        .tile-cell { padding: 0 5px !important; }
        .tile-copy { padding: 15px 12px 17px !important; }
        .tile-title { font-size: 18px !important; line-height: 22px !important; min-height: 44px !important; }
        .tile-artist { font-size: 22px !important; line-height: 25px !important; }
        .tile-meta { font-size: 12px !important; line-height: 18px !important; }
        .total-number { font-size: 58px !important; line-height: 62px !important; }
        .total-label { font-size: 18px !important; line-height: 22px !important; }
        .footer { padding: 30px 24px !important; }
      }
      @media only screen and (max-width: 360px) {
        .tile-copy { padding: 14px 9px 16px !important; }
        .tile-title { font-size: 16px !important; line-height: 20px !important; min-height: 40px !important; letter-spacing: -0.2px !important; }
        .tile-artist { font-size: 20px !important; line-height: 23px !important; }
      }
    </style>
  </head>
  <body style="margin: 0; padding: 0; background-color: #17131b;">
    <div style="display: none; max-height: 0; overflow: hidden; opacity: 0; color: transparent; mso-hide: all;">
      {{ payload.summary.totalNewReleases }} nouvelle{{ payload.summary.totalNewReleases > 1 ? 's' : '' }} sortie{{ payload.summary.totalNewReleases > 1 ? 's' : '' }} cette semaine. Retrouve la sélection et les liens pour écouter.
    </div>
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" bgcolor="#17131b" style="width: 100%; background-color: #17131b;">
      <tr>
        <td align="center" class="outer" style="padding: 32px 12px;">
          <table role="presentation" width="640" cellspacing="0" cellpadding="0" border="0" class="shell" style="width: 640px; max-width: 640px; background-color: {{ brandColor }};">
            <tr>
              <td class="masthead" bgcolor="#17131b" style="padding: 26px 30px; background-color: #17131b;">
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                  <tr>
                    <td class="masthead-name" style="font-family: Arial, Helvetica, sans-serif; font-size: 33px; line-height: 36px; font-weight: 900; letter-spacing: -1.2px; color: #fff8e9;">{{ brandName }}</td>
                    <td class="masthead-note" align="right" style="font-family: Arial, Helvetica, sans-serif; font-size: 11px; line-height: 16px; font-weight: 700; color: #fca779;">TON RENDEZ-VOUS<br />MUSICAL DU LUNDI</td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td bgcolor="{{ brandColor }}" style="background-color: {{ brandColor }};">
                <img src="{{ emailAssetsUrl }}/masthead-v3.png" width="640" height="310" alt="Les sorties de la semaine" style="display: block; width: 100%; max-width: 640px; height: auto; border: 0; color: #17131b; font-family: Arial, Helvetica, sans-serif; font-size: 38px; font-weight: 900;" />
              </td>
            </tr>
            <tr>
              <td class="edition" bgcolor="#17131b" style="padding: 14px 30px; background-color: #17131b; font-family: Arial, Helvetica, sans-serif; font-size: 13px; line-height: 20px; font-weight: 700; color: #fff8e9;">{{ payload.period.label }}</td>
            </tr>
            <tr>
              <td bgcolor="{{ brandColor }}" background="{{ emailAssetsUrl }}/dots-orange-v3.png" style="background-color: {{ brandColor }}; background-image: url('{{ emailAssetsUrl }}/dots-orange-v3.png'); background-repeat: repeat;">
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                  <tr>
                    <td class="intro" style="padding: 30px;">
                      <table role="presentation" cellspacing="0" cellpadding="0" border="0">
                        <tr>
                          <td class="total-number" valign="middle" style="padding-right: 18px; font-family: Arial, Helvetica, sans-serif; font-size: 68px; line-height: 72px; font-weight: 900; letter-spacing: -2px; color: #17131b;">{{ payload.summary.totalNewReleases }}</td>
                          <td valign="middle" style="font-family: Arial, Helvetica, sans-serif; color: #17131b;">
                            <p class="total-label" style="margin: 0; font-size: 21px; line-height: 25px; font-weight: 800;">nouveauté{{ payload.summary.totalNewReleases > 1 ? 's' : '' }}<br />cette semaine</p>
                            @if(payload.releases.length)
                              <p style="margin: 7px 0 0; font-size: 13px; line-height: 19px;">{{ payload.releases.length }} à découvrir dans cet email.</p>
                            @endif
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                  <tr>
                    <td class="content" style="padding: 0 24px 36px;">
                      @if(leadRelease)
                        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" bgcolor="#fff8e9" style="width: 100%; background-color: #fff8e9; border: 2px solid #17131b; border-radius: 12px; border-collapse: separate; overflow: hidden;">
                          <tr>
                            <td width="264" valign="middle" class="lead-art" style="width: 264px;">
                              <a href="{{ leadRelease.detailUrl }}" style="text-decoration: none;">
                                <img src="{{ leadRelease.coverUrl }}" width="264" height="264" class="lead-cover" alt="Pochette de {{ leadRelease.title }}" style="display: block; width: 264px; height: 264px; border: 0; background-color: #e2d9cb;" />
                              </a>
                            </td>
                            <td class="lead-copy" valign="middle" style="padding: 26px;">
                              @if(leadRelease.artistName)
                                <p class="lead-artist" style="margin: 0 0 7px; font-family: Arial, Helvetica, sans-serif; font-size: 32px; line-height: 35px; font-weight: 900; letter-spacing: -0.8px; overflow-wrap: anywhere; color: #17131b;">{{ leadRelease.artistName }}</p>
                              @endif
                              <h1 class="lead-title" style="margin: 0 0 19px; font-family: Arial, Helvetica, sans-serif; font-size: 27px; line-height: 32px; font-weight: 500; letter-spacing: -0.5px; overflow-wrap: anywhere; color: #514450;">
                                <a href="{{ leadRelease.detailUrl }}" style="color: #514450; text-decoration: none;">{{ leadRelease.title }}</a>
                              </h1>
                              <p style="margin: 0 0 18px; padding-top: 13px; border-top: 1px solid #d9d0bf; font-family: Arial, Helvetica, sans-serif; font-size: 12px; line-height: 19px; color: #514450;">
                                {{ leadRelease.type || 'Sortie' }}
                                @if(leadRelease.releaseDateLabel)
                                  &nbsp;·&nbsp; Sortie le<br /><strong style="font-size: 14px; line-height: 22px; color: #17131b;">{{ leadRelease.releaseDateLabel }}</strong>
                                @endif
                              </p>
                              @if(leadRelease.categories && leadRelease.categories.length)
                                <p style="margin: 0 0 16px; font-family: Arial, Helvetica, sans-serif; font-size: 12px; line-height: 18px; color: #514450;">{{ leadRelease.categories.join(' · ') }}</p>
                              @endif
                              <table role="presentation" cellspacing="0" cellpadding="0" border="0"><tr><td bgcolor="#17131b" style="background-color: #17131b; border-radius: 4px; mso-padding-alt: 13px 18px;">
                                <a href="{{ leadRelease.detailUrl }}" style="display: inline-block; padding: 13px 18px; border: 1px solid #17131b; font-family: Arial, Helvetica, sans-serif; font-size: 13px; line-height: 18px; font-weight: 700; color: #fff8e9; text-decoration: none;">Voir la sortie</a>
                              </td></tr></table>
                            </td>
                          </tr>
                        </table>
                        @each(row in releaseRows)
                          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width: 100%; table-layout: fixed;">
                            <tr><td colspan="2" height="18" style="height: 18px; font-size: 0; line-height: 0;">&nbsp;</td></tr>
                            <tr>
                              @each((release, index) in row)
                                <td width="50%" valign="top" class="tile-cell" style="width: 50%; padding-left: {{ index === 0 ? '0' : '9px' }}; padding-right: {{ index === 0 ? '9px' : '0' }};">
                                  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" bgcolor="#fff8e9" style="width: 100%; background-color: #fff8e9; border: 2px solid #17131b; border-radius: 12px; overflow: hidden; border-collapse: separate;">
                                    <tr><td>
                                      <a href="{{ release.detailUrl }}" style="text-decoration: none;"><img src="{{ release.coverUrl }}" width="279" height="279" alt="Pochette de {{ release.title }}" style="display: block; width: 100%; height: auto; border: 0; background-color: #e2d9cb;" /></a>
                                    </td></tr>
                                    <tr>
                                      <td class="tile-copy" style="padding: 20px 20px 22px;">
                                        @if(release.artistName)
                                          <p class="tile-artist" style="margin: 0 0 6px; font-family: Arial, Helvetica, sans-serif; font-size: 25px; line-height: 28px; font-weight: 900; letter-spacing: -0.5px; overflow-wrap: anywhere; color: #17131b;">{{ release.artistName }}</p>
                                        @endif
                                        <h2 class="tile-title" style="min-height: 52px; margin: 0 0 14px; font-family: Arial, Helvetica, sans-serif; font-size: 22px; line-height: 26px; font-weight: 500; letter-spacing: -0.3px; overflow-wrap: anywhere; color: #514450;"><a href="{{ release.detailUrl }}" style="color: #514450; text-decoration: none;">{{ release.title }}</a></h2>
                                        <p class="tile-meta" style="margin: 0 0 10px; padding-top: 12px; border-top: 1px solid #d9d0bf; font-family: Arial, Helvetica, sans-serif; font-size: 12px; line-height: 19px; color: #514450;">{{ release.type || 'Sortie' }}
                                          @if(release.releaseDateLabel)
                                            &nbsp;·&nbsp; Sortie le<br /><strong style="font-size: 13px; line-height: 21px; color: #17131b;">{{ release.releaseDateLabel }}</strong>
                                          @endif
                                        </p>
                                        @if(release.categories && release.categories.length)
                                          <p style="margin: 0 0 14px; font-family: Arial, Helvetica, sans-serif; font-size: 12px; line-height: 18px; color: #514450;">{{ release.categories.join(' · ') }}</p>
                                        @endif
                                        <a href="{{ release.detailUrl }}" style="display: inline-block; padding: 7px 0; font-family: Arial, Helvetica, sans-serif; font-size: 13px; line-height: 20px; font-weight: 700; color: #17131b; text-decoration: underline; text-underline-offset: 4px;">Découvrir</a>
                                      </td>
                                    </tr>
                                  </table>
                                </td>
                              @endeach
                              @if(row.length === 1)
                                <td width="50%" style="width: 50%;">&nbsp;</td>
                              @endif
                            </tr>
                          </table>
                        @endeach
                      @else
                        <p style="margin: 0; padding: 28px; background-color: #fff8e9; font-family: Arial, Helvetica, sans-serif; font-size: 17px; line-height: 26px; color: #17131b;">La sélection est vide cette semaine. Retrouve les autres sorties sur le site.</p>
                      @endif
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td class="footer" bgcolor="#fff8e9" style="padding: 34px 32px; background-color: #fff8e9; border-top: 2px solid #17131b;">
                <p style="margin: 0 0 10px; font-family: Arial, Helvetica, sans-serif; font-size: 36px; line-height: 39px; font-weight: 900; letter-spacing: -1px; color: #17131b;">Bonne écoute.</p>
                <p style="margin: 0 0 22px; font-family: Arial, Helvetica, sans-serif; font-size: 15px; line-height: 23px; color: #514450;">Et si tu cherches encore quoi écouter, la suite est sur {{ brandName }}.</p>
                <table role="presentation" cellspacing="0" cellpadding="0" border="0"><tr><td bgcolor="#17131b" style="background-color: #17131b; border-radius: 4px; mso-padding-alt: 13px 18px;"><a href="{{ appUrl }}" style="display: inline-block; padding: 14px 20px; border: 1px solid #17131b; font-family: Arial, Helvetica, sans-serif; font-size: 14px; line-height: 20px; font-weight: 700; color: #fff8e9; text-decoration: none;">Voir les autres sorties</a></td></tr></table>
              </td>
            </tr>
            <tr>
              <td bgcolor="#17131b" style="padding: 26px 28px; background-color: #17131b;">
                <p style="margin: 0 0 12px; font-family: Arial, Helvetica, sans-serif; font-size: 19px; line-height: 25px; font-weight: 800; letter-spacing: -0.6px; color: #fff8e9;">{{ brandName }}</p>
                <p style="margin: 0; font-family: Arial, Helvetica, sans-serif; font-size: 12px; line-height: 19px; color: #c7bdce;">Tu reçois ce rendez-vous car tu es abonné·e à la newsletter.<br />Pour ne plus le recevoir, réponds à ce message.</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
